# ---------------------------------------------------------------------------
# Breathe AI by Noconi — environment template
#
# Copy this file to `.env`, then fill in the values. Never commit `.env`.
# Restart the server after editing: the file is only read at startup, so a
# running process keeps whatever values it started with.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# 1. AI provider — required for the AI coach
#
# Choose ONE of the two options below. AI_PROVIDER is detected automatically
# from which key is present, so setting it is only necessary to override that.
# ---------------------------------------------------------------------------

# --- Option A: any OpenAI-compatible endpoint ------------------------------
# Works with OpenAI itself, or with a gateway that exposes /chat/completions.
# Set AI_PROVIDER to "openai" to force this option.
AI_PROVIDER=openai

# Your provider's key. A gateway key only works against that gateway's URL.
OPENAI_API_KEY=

# Base URL of your provider, usually ending in /v1.
# Leave empty to use https://api.openai.com/v1.
# Example: OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_BASE_URL=

# Model name, spelled the way your provider spells it.
OPENAI_MODEL=gpt-4o-mini


# --- Option B: Google Gemini ----------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Gemini keys are about 39 characters and start with "AIza". A key from any
# other provider will be rejected here with "API key not valid".
# Comment out the Option A lines above and uncomment these to switch.
#
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash


# --- Shared AI options -----------------------------------------------------
# Per-request timeout in milliseconds. Default 25000.
# AI_TIMEOUT_MS=25000


# ---------------------------------------------------------------------------
# 2. Cloud sync — OFF by default (the app is local-first)
#
# By default everything is stored in the browser's IndexedDB and nobody is
# asked to sign in. That is the intended MVP behaviour: no backend, no login
# wall, nothing to configure.
#
# To turn cloud sync on, set VITE_ENABLE_CLOUD_SYNC=true, fill in both Supabase
# values below, and run supabase-schema.sql in your Supabase project.
#
# These are read at BUILD time, so restart or rebuild after changing them.
# Both values are inlined into the client bundle, so only ever put the public
# anon key here — never the service-role key.
# ---------------------------------------------------------------------------
VITE_ENABLE_CLOUD_SYNC=false

# Only used when VITE_ENABLE_CLOUD_SYNC=true.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# 3. Optional
# ---------------------------------------------------------------------------
# Port for the local server. Default 3000.
# PORT=3000

# Set to "true" to disable Vite HMR.
# DISABLE_HMR=false


# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - APP_URL is no longer read anywhere in this project.
# - NODE_ENV and VERCEL are provided by the hosting platform; do not set them.
# - VITE_GEMINI_API_KEY is still accepted as a legacy fallback for
#   GEMINI_API_KEY, but avoid it: the VITE_ prefix means Vite can expose the
#   value to the browser. Use GEMINI_API_KEY instead.
# - Verify the server picked up your settings with:
#     curl http://localhost:3000/api/health
